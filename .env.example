# ==========================================
# KarirTrack Environment Variables Template
# Copy this file to `.env` and fill in the values.
# ==========================================

# --- Backend ---
APP_ENV=development

# Neon: use the pooled host for the app and the direct host for Alembic.
# Local Postgres example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/karirtrack
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/karirtrack?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/karirtrack?sslmode=require

JWT_SECRET_KEY=ganti_dengan_random_secret_key_minimal_32_karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Web Client ID (same value as the frontend).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Comma-separated list. Production example:
# CORS_ORIGINS=https://karir-oyyy.vercel.app
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cookies. In production: COOKIE_SECURE=true, COOKIE_SAMESITE=lax (same-origin).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth

# Hard cap for report exports (Vercel response limit is 4.5 MB).
MAX_EXPORT_ROWS=2000

# --- Frontend (Vite reads these from the repo root via envDir) ---
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
